@startuml TicketMiner_PA2

' ============================================================
' STYLE — no colors, straight orthogonal lines
' ============================================================
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam classBorderColor #333333
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #FFFFFF
skinparam arrowColor #333333
skinparam arrowThickness 1.2
skinparam packageBorderColor #333333
skinparam packageBackgroundColor #FFFFFF
skinparam packageFontStyle bold
skinparam shadowing false
skinparam linetype ortho

top to bottom direction

' ============================================================
' ROW 1 — INTERFACES
' ============================================================
together {
  interface Reportable {
    + generateReport() : String
  }

  interface Printable {
    + printToFile(fileName : String) : void
  }
}

' ============================================================
' ROW 2 — CORE SYSTEM
' ============================================================
together {
  class RunTicketMiner {
    - dataManager    : DataManager
    - userMap        : HashMap<String, User>
    - venueMap       : HashMap<Integer, Venue>
    - eventMap       : HashMap<Integer, Event>
    - in             : Scanner
    - loggedInUser   : User
    --
    + {static} main(args : String[]) : void
    + displayMainMenu() : void
    + registerCustomer() : void
    + registerOrganizer() : void
    + registerAdmin() : void
    + login() : void
    + customerMenu() : void
    + organizerMenu() : void
    + adminMenu() : void
    + manageUsers() : void
    + addUser() : void
    + viewUser() : void
    + updateUser() : void
    + deleteUser() : void
    + manageVenues() : void
    + addVenue() : void
    + viewVenue() : void
    + updateVenue() : void
    + deleteVenue() : void
    + manageEvents() : void
    + addEvent() : void
    + viewEvent() : void
    + updateEvent() : void
    + deleteEvent() : void
    + purchaseTickets() : void
    + generateEventReport() : void
    + saveUpdatedData() : void
    - isUsernameUnique(username : String) : boolean
    - readNonBlank(prompt : String) : String
    - readPositiveInt(prompt : String) : int
    - readPositiveDouble(prompt : String) : double
    - readDate(prompt : String) : String
    - readTime(prompt : String) : String
    - resolveUser(input : String) : User
    - resolveVenue(input : String) : Venue
    - resolveEvent(input : String) : Event
  }

  class DataManager {
    - lastUserIDSeen  : int
    - lastVenueIDSeen : int
    - lastEventIDSeen : int
    --
    + findUsers(userMap : HashMap<String,User>, query : String) : List<User>
    + findVenues(venueMap : HashMap<Integer,Venue>, query : String) : List<Venue>
    + findEvents(eventMap : HashMap<Integer,Event>, query : String) : List<Event>
    + loadUsers(fileName : String) : HashMap<String, User>
    + loadEvents(fileName : String) : HashMap<Integer, Event>
    + loadVenues(fileName : String) : HashMap<Integer, Venue>
    + writeUsers(fileName : String, userMap : HashMap<String,User>) : void
    + writeEvent(fileName : String, eventMap : HashMap<Integer,Event>) : void
    + writeVenues(fileName : String, venueMap : HashMap<Integer,Venue>) : void
    + writeTransactions(fileName : String, transactions : List<Transaction>) : void
    + generateUniqueUserId() : int
    + generateUniqueVenueId() : int
    + generateUniqueEventId() : int
    + generateUniqueTransactionId() : int
    - resolveColumnIndex(headers : String[], columnName : String) : int
  }

  class Logger <<Singleton>> {
    - {static} instance : Logger
    --
    - Logger()
    + {static} getInstance() : Logger
    + {static} logAction(actionDetail : String) : void
  }
}

' ============================================================
' ROW 3 — ABSTRACT PARENTS  (User | Transaction | Event | Venue)
' ============================================================
together {
  abstract class User {
    - firstName : String
    - lastName  : String
    - username  : String
    - password  : String
    - userID    : int
    - userType  : String
    --
    + getFirstName() : String
    + setFirstName(firstName : String) : void
    + getLastName() : String
    + setLastName(lastName : String) : void
    + getUsername() : String
    + setUsername(username : String) : void
    + getPassword() : String
    + setPassword(password : String) : void
    + getUserID() : int
    + setUserID(userID : int) : void
    + getUserType() : String
    + setUserType(userType : String) : void
    + toString() : String
  }

  class Transaction {
    - transactionID      : int
    - confirmationNumber : String
    - ticketType         : String
    - quantity           : int
    - subtotal           : double
    - membershipDiscount : double
    - taxAmount          : double
    - totalPrice         : double
    --
    + getTransactionID() : int
    + getConfirmationNumber() : String
    + getTicketType() : String
    + getQuantity() : int
    + getSubtotal() : double
    + getMembershipDiscount() : double
    + getTaxAmount() : double
    + getTotalPrice() : double
    + printToFile(fileName : String) : void
    + toString() : String
  }

  abstract class Event {
    - eventID               : int
    - type                  : String
    - name                  : String
    - date                  : String
    - time                  : String
    - vipPrice              : double
    - goldPrice             : double
    - silverPrice           : double
    - bronzePrice           : double
    - generalAdmissionPrice : double
    - vipSeatsTotal         : int
    - goldSeatsTotal        : int
    - silverSeatsTotal      : int
    - bronzeSeatsTotal      : int
    - generalAdmSeatsTotal  : int
    - vipSeatsSold          : int
    - goldSeatsSold         : int
    - silverSeatsSold       : int
    - bronzeSeatsSold       : int
    - generalAdmSeatsSold   : int
    - totalRevenue          : double
    - taxCollected          : double
    - venue                 : Venue
    --
    + getEventID() : int
    + setEventID(eventID : int) : void
    + getType() : String
    + setType(type : String) : void
    + getEventName() : String
    + setEventName(name : String) : void
    + getDate() : String
    + setDate(date : String) : void
    + getTime() : String
    + setTime(time : String) : void
    + getVipPrice() : double
    + getGoldPrice() : double
    + getSilverPrice() : double
    + getBronzePrice() : double
    + getGeneralAdmissionPrice() : double
    + getVipSeatsAvailable() : int
    + getGoldSeatsAvailable() : int
    + getSilverSeatsAvailable() : int
    + getBronzeSeatsAvailable() : int
    + getGeneralAdmSeatsAvailable() : int
    + getVipSeatsSold() : int
    + getGoldSeatsSold() : int
    + getSilverSeatsSold() : int
    + getBronzeSeatsSold() : int
    + getGeneralAdmSeatsSold() : int
    + sellSeats(ticketType : String, quantity : int) : void
    + getTotalRevenue() : double
    + getTaxCollected() : double
    + addRevenue(amount : double, tax : double) : void
    + getVenue() : Venue
    + setVenue(venue : Venue) : void
    + generateReport() : String
    + toString() : String
  }

  abstract class Venue {
    - venueID                 : int
    - name                    : String
    - type                    : String
    - capacity                : int
    - concertCapacity         : int
    - cost                    : double
    - vipPercent              : int
    - goldPercent             : int
    - silverPercent           : int
    - bronzePercent           : int
    - generalAdmissionPercent : int
    - reservedPercent         : int
    --
    + getVenueID() : int
    + getName() : String
    + setName(name : String) : void
    + getType() : String
    + setType(type : String) : void
    + getCapacity() : int
    + setCapacity(capacity : int) : void
    + getConcertCapacity() : int
    + setConcertCapacity(concertCapacity : int) : void
    + getCost() : double
    + setCost(cost : double) : void
    + getVipPercent() : int
    + setVipPercent(vipPercent : int) : void
    + getGoldPercent() : int
    + setGoldPercent(goldPercent : int) : void
    + getSilverPercent() : int
    + setSilverPercent(silverPercent : int) : void
    + getBronzePercent() : int
    + setBronzePercent(bronzePercent : int) : void
    + getGeneralAdmissionPercent() : int
    + setGeneralAdmissionPercent(generalAdmissionPercent : int) : void
    + getReservedPercent() : int
    + setReservedPercent(reservedPercent : int) : void
    + toString() : String
  }
}

' ============================================================
' ROW 4 — CONCRETE SUBCLASSES
' ============================================================
together {
  class Customer {
    - moneyAvailable    : double
    - hasMembership     : boolean
    - concertsPurchased : int
    - transactions      : List<Transaction>
    - totalTaxPaid      : double
    --
    + getMoneyAvailable() : double
    + setMoneyAvailable(moneyAvailable : double) : void
    + hasMembership() : boolean
    + setMembership(hasMembership : boolean) : void
    + getConcertsPurchased() : int
    + setConcertsPurchased(concertsPurchased : int) : void
    + getTransactions() : List<Transaction>
    + addTransaction(t : Transaction) : void
    + getTotalTaxPaid() : double
    + purchaseTicket(event : Event, ticketType : String, quantity : int) : Transaction
    + generateReport() : String
    + printToFile(fileName : String) : void
    + toString() : String
  }

  class Organizer {
    --
    + createEvent() : void
  }

  class Admin {
  }

  class Concert {
  }

  class Sport {
  }

  class Special {
  }

  class Arena {
  }

  class Auditorium {
  }

  class Stadium {
  }

  class OpenAir {
  }
}

' ============================================================
' ROW 5 — EXCEPTIONS
' ============================================================
together {
  class InsufficientFundsException {
    - message : String
    --
    + InsufficientFundsException(message : String)
    + getMessage() : String
  }

  class TicketUnavailableException {
    - message : String
    --
    + TicketUnavailableException(message : String)
    + getMessage() : String
  }
}

InsufficientFundsException -up-|> Exception
TicketUnavailableException  -up-|> Exception

' ============================================================
' INHERITANCE  (straight down)
' ============================================================
Customer  -up-|> User
Organizer -up-|> User
Admin     -up-|> User

Concert -up-|> Event
Sport   -up-|> Event
Special -up-|> Event

Arena      -up-|> Venue
Auditorium -up-|> Venue
Stadium    -up-|> Venue
OpenAir    -up-|> Venue

' ============================================================
' INTERFACE REALIZATIONS
' ============================================================
Customer    .up.|> Reportable
Customer    .up.|> Printable
Event       .up.|> Reportable
Transaction .up.|> Printable

' ============================================================
' ASSOCIATIONS
' ============================================================
RunTicketMiner "1" o-- "1"    DataManager : uses
RunTicketMiner      .>         Logger      : logs via
RunTicketMiner "1" o-- "0..*" User        : manages
RunTicketMiner "1" o-- "0..*" Event       : manages
RunTicketMiner "1" o-- "0..*" Venue       : manages

Customer "1"    *-- "0..*" Transaction : has
Transaction "0..*" --> "1"  Event       : for
Event "0..*"       --> "1"  Venue       : held at

' ============================================================
' EXCEPTION THROWS
' ============================================================
Customer -down-> InsufficientFundsException : <<throws>>
Customer -down-> TicketUnavailableException : <<throws>>
Event    -down-> TicketUnavailableException : <<throws>>

@enduml
